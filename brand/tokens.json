{
  "$comment": "The one source for Broccoli Tree Design's colours and logo. Edit this file, then run `npm run brand`: it rewrites app/brand.css, the logo and icon files, the exports in brand/exports/, and the generated tables in brand/guidelines/DESIGN.md, and fails if any contrast check drops below its minimum.",
  "color": {
    "green": {
      "950": { "hex": "#050d0a", "use": "near-black: the black box's dark faces, darkest strokes" },
      "900": { "hex": "#102e27", "use": "button ink on dark, shadow tint, the black box's lid" },
      "800": { "hex": "#0e372d", "use": "dark ground, light ink, browser bar, logo tile and pupil" },
      "600": { "hex": "#476f33", "use": "light-theme accent" },
      "500": { "hex": "#609546", "use": "the logo; any graphic that sits on both grounds" },
      "300": { "hex": "#a8cf8a", "use": "dark-theme accent, text selection" }
    },
    "neutral": {
      "700": { "hex": "#3c4a3f", "use": "light-theme muted text" },
      "200": { "hex": "#d7dccb", "use": "dark-theme muted text" },
      "100": { "hex": "#f6f5e5", "use": "light ground, dark ink, eye white" }
    },
    "orange": {
      "800": { "hex": "#742f15", "use": "light-theme button hover" },
      "600": { "hex": "#9e4220", "use": "light-theme warm and button" },
      "400": { "hex": "#fb7e4f", "use": "dark-theme warm and button" },
      "300": { "hex": "#fd976f", "use": "dark-theme button hover" }
    }
  },
  "roles": {
    "bg": { "dark": "green-800", "light": "neutral-100", "use": "page ground" },
    "ink": { "dark": "neutral-100", "light": "green-800", "use": "headlines, nav, captions" },
    "muted": { "dark": "neutral-200", "light": "neutral-700", "use": "body copy, descriptions" },
    "accent": { "dark": "green-300", "light": "green-600", "use": "links, italic emphasis, stats, rings, vines, focus ring" },
    "warm": { "dark": "orange-400", "light": "orange-600", "use": "eyebrows, alternate service numbers, text links, the CTA's emphasis" },
    "button": { "dark": "orange-400", "light": "orange-600", "use": "the Let's chat button" },
    "button-hover": { "dark": "orange-300", "light": "orange-800", "use": "the button on hover" },
    "button-ink": { "dark": "green-900", "light": "neutral-100", "use": "text on the button" }
  },
  "contrast": [
    { "name": "Ink on ground", "fg": "ink", "bg": "bg", "min": 4.5 },
    { "name": "Muted text", "fg": "muted", "bg": "bg", "min": 4.5 },
    { "name": "Accent", "fg": "accent", "bg": "bg", "min": 4.5 },
    { "name": "Warm", "fg": "warm", "bg": "bg", "min": 4.5 },
    { "name": "Button label", "fg": "button-ink", "bg": "button", "min": 4.5 },
    { "name": "Button hover", "fg": "button-ink", "bg": "button-hover", "min": 4.5 },
    { "name": "Logo on ground", "fg": "green-500", "bg": "bg", "min": 3 }
  ],
  "logo": {
    "leaf": "green-500",
    "eye": "neutral-100",
    "pupil": "green-800",
    "shadow": "green-800",
    "tile": "green-800",
    "lightTile": "neutral-100",
    "eyeRy": 15.625,
    "pupilRx": 6.25,
    "pupilRy": 13
  },
  "browserBar": "green-800",
  "linkedinCover": {
    "ground": "green-800",
    "vine": "green-500",
    "bud": "green-300",
    "strokeWidth": 2,
    "leafSize": 36,
    "leavesPerStem": 3,
    "eyeSize": 48
  }
}
